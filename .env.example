# Postgres with pgvector + full-text search.
# Neon writes these into `.env.local`: the pooled URL for app traffic, the
# direct URL for migrations (drizzle.config.ts prefers the unpooled one).
DATABASE_URL=postgres://user:pass@localhost:5432/curio
DATABASE_URL_UNPOOLED=postgres://user:pass@localhost:5432/curio

# A model key, for the chat + embedding calls. Not needed on a Sprite that
# routes through the OpenRouter connector (see SPRITES_GATEWAY_URL).
OPENROUTER_API_KEY=

# On a Fly Sprite: the connector gateway base for OpenRouter, e.g.
# https://api.sprites.dev/v1/gateway/openrouter/<connection_id>/v1
# When set, model calls go through it and no key is needed.
SPRITES_GATEWAY_URL=

# Embedding width. Must match the model and the schema's vector(1536).
EMBEDDING_DIM=1536

# HTTP port for the app/API.
PORT=8787

# Auth (better-auth).
# The signing secret, and the public base URL of the app that SERVES auth —
# the web origin, not the API's.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Extra browser origins allowed to call auth (comma-separated). A browser sends
# an Origin header; without a match better-auth answers INVALID_ORIGIN.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Optional: a system Chrome for the JS-page fallback renderer.
CHROME_PATH=
