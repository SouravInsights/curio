{
  "name": "curio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A reading app with an agent, and a harness your other agents can use.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "cli": "tsx packages/core/src/harness/cli.ts",
    "mcp": "tsx packages/core/src/harness/cli.ts mcp",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "cd packages/core && drizzle-kit studio"
  },
  "devDependencies": {
    "@neon/config": "^1.14.8",
    "@neon/env": "^2.1.11",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsx": "^4.19.3",
    "turbo": "^2.5.8",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "bun@1.4.0"
}
