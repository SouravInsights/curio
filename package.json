{
  "name": "curio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A reading app with an agent, and a harness your other agents can use.",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "cli": "tsx src/harness/cli.ts",
    "mcp": "tsx src/harness/cli.ts mcp",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neon/config": "^1.14.8",
    "@neon/env": "^2.1.11",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.143",
    "better-auth": "^1.7.28",
    "defuddle": "0.19.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.42.0",
    "hono": "^4.7.0",
    "js-tiktoken": "^1.0.21",
    "jsdom": "26.1.0",
    "postgres": "^3.4.5",
    "puppeteer-core": "^25.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsx": "^4.19.3",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "bun@1.4.0"
}
